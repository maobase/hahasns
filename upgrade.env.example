# upgrade.sh 配置模板 —— 复制为 upgrade.env（不入 git）并按需修改。详见 UPGRADE.md。
# 数据库连接通常已在 server-nest/.env，脚本会自动读取，这里一般无需重复填。

# 部署形态：baremetal（宿主机直跑 Node）| docker（docker compose）
DEPLOY_MODE=baremetal

# 重启命令（baremetal）。留空则自动探测 systemd 服务 hahasns。
# RESTART_CMD="sudo systemctl restart hahasns"

# npm 源
# NPM_REGISTRY=https://registry.npmjs.org

# ---- 仅 DEPLOY_MODE=docker 时 ----
# COMPOSE_FILE=docker-compose.prod.yml
# DB_CONTAINER=hahasns-mariadb      # 备份 + 首次接入迁移标记用；并在 compose app env 设 DB_MIGRATIONS_RUN=true

# ---- 可选 ----
# SKIP_BACKUP=0     # 1 = 跳过数据库备份
# SKIP_CLIENT=0     # 1 = 跳过前端构建
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=hahasns
# DB_PASSWORD=
# DB_NAME=hahasns
